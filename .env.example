MAIL_PASSWORD=
MAIL_FROM=
MAIL_IMAP_FOLDER=INBOX
MAIL_POLL_ENABLED=true
MAIL_POLL_MINUTES=10

# Разбор ответов поставщиков (опционально; без ключа — эвристики)
