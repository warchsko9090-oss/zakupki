APP_NAME=Закупки
APP_PASSWORD=zakupki
SECRET_KEY=replace-with-long-random-string

# Локально ./data; на Amvera /data (том)
DATA_DIR=./data

# Подпись в письмах
SENDER_NAME=Отдел закупок
SENDER_COMPANY=

# Яндекс почта (пароль приложения: https://id.yandex.ru/security/app-passwords)
