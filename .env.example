APP_NAME=Закупки
APP_PASSWORD=zakupki
SECRET_KEY=replace-with-long-random-string

# Локально ./data; на Amvera /data (том)
DATA_DIR=./data

# Подпись в письмах (файл сохраняйте в UTF-8, без кавычек вокруг значений)
SENDER_NAME=Отдел закупок
SENDER_COMPANY=

# Яндекс почта
# 1) Включите IMAP: mail.yandex.ru → Настройки → Почтовые программы
# 2) Пароль ПРИЛОЖЕНИЯ (не обычный): https://id.yandex.ru/security/app-passwords
#    Вставляйте 16 символов без пробелов и дефисов
MAIL_SMTP_HOST=smtp.yandex.ru
MAIL_SMTP_PORT=465
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_IMAP_FOLDER=INBOX
MAIL_POLL_ENABLED=true
MAIL_POLL_MINUTES=3

# AI: https://aistudio.google.com
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-flash-latest
AI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_ENABLED=true

PORT=3001
